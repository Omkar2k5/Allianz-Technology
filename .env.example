# Database Configuration
DB_PASSWORD=omkar9211
DATABASE_URL=postgresql://admin:${DB_PASSWORD}@postgres:5432/ecocompute

# Authentication
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# GenAI Provider API Keys (for proxy forwarding)
OPENAI_API_KEY=sk-your-openai-key-here
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
GOOGLE_AI_KEY=your-google-ai-key-here

# Service URLs
ANALYTICS_API_URL=http://analytics-api:8000
PROXY_URL=http://genai-proxy:8001
FRONTEND_URL=http://localhost:3000

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000

# Proxy Configuration
PROXY_PORT=8001
PROXY_LOG_LEVEL=info

# Analytics API Configuration
API_PORT=8000
API_LOG_LEVEL=info

# Carbon Intensity Data Source (optional)
CARBON_INTENSITY_API_KEY=your-carbon-api-key
CARBON_INTENSITY_API_URL=https://api.carbonintensity.org.uk

# Policy Enforcement
ENABLE_POLICY_ENFORCEMENT=true
DEFAULT_POLICY_MODE=warn  # warn, block, or allow

# Monitoring & Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=  # Optional error tracking

# Development
DEBUG=false
ENVIRONMENT=development  # development, staging, production

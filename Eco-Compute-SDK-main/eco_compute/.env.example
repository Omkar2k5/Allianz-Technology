# Eco-Compute SDK Environment Variables
# Copy this file to .env and set your API key

# OpenRouter API Key (Required for live inference)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: Telemetry Configuration
# ECO_TELEMETRY_ENDPOINT=https://api.example.com/telemetry
# ECO_TELEMETRY_TOKEN=your-telemetry-token
